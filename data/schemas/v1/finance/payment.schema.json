{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-solutions-lab.local/schemas/v1/finance/payment.schema.json",
  "title": "Payment",
  "description": "Money applied to an invoice. Synthetic laboratory data only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "invoice_id",
    "amount",
    "method",
    "status",
    "received_on",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/payment_id" },
    "invoice_id": { "$ref": "../common.schema.json#/$defs/invoice_id" },
    "amount": { "$ref": "../common.schema.json#/$defs/money" },
    "method": {
      "type": "string",
      "enum": ["ach", "check", "card", "wire", "credit_memo"]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "posted", "failed", "reversed"]
    },
    "received_on": { "$ref": "../common.schema.json#/$defs/iso_date" },
    "reference": { "type": "string" },
    "received_by_employee_id": {
      "$ref": "../common.schema.json#/$defs/employee_id"
    },
    "notes": { "type": "string" },
    "created_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
    "updated_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" }
  }
}
