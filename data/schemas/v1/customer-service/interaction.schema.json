{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-solutions-lab.local/schemas/v1/customer-service/interaction.schema.json",
  "title": "Interaction",
  "description": "Customer touch summary. Synthetic laboratory data only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "customer_id",
    "channel",
    "occurred_at",
    "summary",
    "employee_id",
    "outcome",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/interaction_id" },
    "customer_id": { "$ref": "../common.schema.json#/$defs/customer_id" },
    "contact_id": { "$ref": "../common.schema.json#/$defs/contact_id" },
    "support_ticket_id": { "$ref": "../common.schema.json#/$defs/ticket_id" },
    "work_order_id": { "$ref": "../common.schema.json#/$defs/work_order_id" },
    "channel": { "$ref": "../common.schema.json#/$defs/channel" },
    "occurred_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
    "summary": { "type": "string", "minLength": 1 },
    "employee_id": { "$ref": "../common.schema.json#/$defs/employee_id" },
    "outcome": {
      "type": "string",
      "enum": ["answered", "voicemail", "scheduled", "escalated", "no_contact"]
    },
    "created_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
    "updated_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" }
  }
}
