{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-solutions-lab.local/schemas/v1/common.schema.json",
  "title": "Wasatch common definitions",
  "description": "Shared identifier, time, money, and address definitions. Synthetic laboratory contracts only.",
  "$defs": {
    "iso_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date",
      "description": "Calendar date in UTC business context, YYYY-MM-DD."
    },
    "iso_datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time",
      "description": "UTC timestamp with a Z suffix."
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$",
          "description": "Decimal string with exactly two fractional digits."
        },
        "currency": {
          "type": "string",
          "const": "USD",
          "description": "ISO 4217 currency. Laboratory fixtures are USD only."
        }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line1", "city", "state", "postal_code", "country"],
      "properties": {
        "line1": { "type": "string", "minLength": 1 },
        "line2": { "type": "string" },
        "city": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "const": "UT" },
        "postal_code": {
          "type": "string",
          "pattern": "^[0-9]{5}(-[0-9]{4})?$"
        },
        "country": { "type": "string", "const": "US" }
      }
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+1-(801|385|435)-555-01[0-9]{2}$",
      "description": "Fictional NANP number using 555-0100 through 555-0199."
    },
    "email": {
      "type": "string",
      "format": "email",
      "pattern": "^[^@]+@[^@]+\\.test$",
      "description": "Synthetic email using the reserved .test TLD."
    },
    "customer_id": { "type": "string", "pattern": "^cust_[0-9]{4}$" },
    "contact_id": { "type": "string", "pattern": "^con_[0-9]{4}$" },
    "location_id": { "type": "string", "pattern": "^loc_[0-9]{4}$" },
    "employee_id": { "type": "string", "pattern": "^emp_[0-9]{4}$" },
    "role_id": { "type": "string", "pattern": "^role_[0-9]{4}$" },
    "team_id": { "type": "string", "pattern": "^team_[0-9]{4}$" },
    "equipment_id": { "type": "string", "pattern": "^eq_[0-9]{4}$" },
    "work_order_id": { "type": "string", "pattern": "^wo_[0-9]{4}$" },
    "task_id": { "type": "string", "pattern": "^wot_[0-9]{4}$" },
    "appointment_id": { "type": "string", "pattern": "^appt_[0-9]{4}$" },
    "invoice_id": { "type": "string", "pattern": "^inv_[0-9]{4}$" },
    "invoice_line_id": { "type": "string", "pattern": "^il_[0-9]{4}$" },
    "payment_id": { "type": "string", "pattern": "^pay_[0-9]{4}$" },
    "document_id": { "type": "string", "pattern": "^doc_[0-9]{4}$" },
    "document_version_id": { "type": "string", "pattern": "^dv_[0-9]{4}$" },
    "extraction_id": { "type": "string", "pattern": "^dx_[0-9]{4}$" },
    "ticket_id": { "type": "string", "pattern": "^tkt_[0-9]{4}$" },
    "message_id": { "type": "string", "pattern": "^msg_[0-9]{4}$" },
    "interaction_id": { "type": "string", "pattern": "^ixn_[0-9]{4}$" },
    "approval_id": { "type": "string", "pattern": "^apr_[0-9]{4}$" },
    "audit_id": { "type": "string", "pattern": "^aud_[0-9]{4}$" },
    "department": {
      "type": "string",
      "enum": [
        "field_operations",
        "dispatch",
        "customer_service",
        "sales",
        "accounting",
        "human_resources",
        "parts",
        "management"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high", "emergency"]
    },
    "channel": {
      "type": "string",
      "enum": ["phone", "email", "sms", "portal", "note", "in_person"]
    }
  }
}
