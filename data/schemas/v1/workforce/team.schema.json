{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-solutions-lab.local/schemas/v1/workforce/team.schema.json",
  "title": "Team",
  "description": "Operational grouping of employees. Synthetic laboratory data only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "department", "created_at", "updated_at"],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/team_id" },
    "name": { "type": "string", "minLength": 1 },
    "department": { "$ref": "../common.schema.json#/$defs/department" },
    "lead_employee_id": { "$ref": "../common.schema.json#/$defs/employee_id" },
    "service_area": { "type": "string" },
    "created_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
    "updated_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" }
  }
}
