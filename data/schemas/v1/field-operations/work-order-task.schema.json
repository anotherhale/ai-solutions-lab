{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-solutions-lab.local/schemas/v1/field-operations/work-order-task.schema.json",
  "title": "WorkOrderTask",
  "description": "Checklist item on a work order. Synthetic laboratory data only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "work_order_id",
    "sequence",
    "description",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/task_id" },
    "work_order_id": { "$ref": "../common.schema.json#/$defs/work_order_id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "blocked", "cancelled"]
    },
    "assigned_employee_id": {
      "$ref": "../common.schema.json#/$defs/employee_id"
    },
    "completed_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
    "blocked_reason": { "type": "string" },
    "created_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
    "updated_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" }
  }
}
