{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-solutions-lab.local/schemas/v1/governance/audit-event.schema.json",
  "title": "AuditEvent",
  "description": "Append-only significant action record. Synthetic laboratory data only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "occurred_at",
    "actor_type",
    "action",
    "subject_type",
    "subject_id",
    "outcome"
  ],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/audit_id" },
    "occurred_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
    "actor_type": {
      "type": "string",
      "enum": ["employee", "system", "customer"]
    },
    "actor_employee_id": { "$ref": "../common.schema.json#/$defs/employee_id" },
    "action": { "type": "string", "minLength": 1 },
    "subject_type": { "type": "string", "minLength": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "enum": ["succeeded", "failed", "pending"] },
    "approval_request_id": { "$ref": "../common.schema.json#/$defs/approval_id" },
    "details": {
      "type": "object",
      "description": "Optional structured context. Must not contain secrets."
    }
  }
}
