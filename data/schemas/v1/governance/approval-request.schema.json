{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-solutions-lab.local/schemas/v1/governance/approval-request.schema.json",
  "title": "ApprovalRequest",
  "description": "Human decision before a consequential action. Synthetic laboratory data only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "action_type",
    "status",
    "requested_by_employee_id",
    "subject_type",
    "subject_id",
    "rationale",
    "requested_at",
    "decision_history",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/approval_id" },
    "action_type": {
      "type": "string",
      "enum": [
        "send_customer_message",
        "void_invoice",
        "issue_invoice",
        "cancel_work_order",
        "change_schedule",
        "export_records",
        "price_override"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "executed", "cancelled"]
    },
    "requested_by_employee_id": {
      "$ref": "../common.schema.json#/$defs/employee_id"
    },
    "reviewer_employee_id": {
      "$ref": "../common.schema.json#/$defs/employee_id"
    },
    "subject_type": { "type": "string", "minLength": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "decision_notes": { "type": "string" },
    "requested_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
    "decided_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
    "executed_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
    "decision_history": {
      "type": "array",
      "description": "Append-only transition log.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "actor_employee_id", "from_status", "to_status"],
        "properties": {
          "at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
          "actor_employee_id": {
            "$ref": "../common.schema.json#/$defs/employee_id"
          },
          "from_status": { "type": "string" },
          "to_status": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "created_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
    "updated_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" }
  }
}
