{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-solutions-lab.local/schemas/v1/customers/contact.schema.json",
  "title": "Contact",
  "description": "Person at a customer account. Synthetic laboratory data only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "customer_id",
    "first_name",
    "last_name",
    "contact_role",
    "is_primary",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/contact_id" },
    "customer_id": { "$ref": "../common.schema.json#/$defs/customer_id" },
    "first_name": { "type": "string", "minLength": 1 },
    "last_name": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "email": { "$ref": "../common.schema.json#/$defs/email" },
    "phone": { "$ref": "../common.schema.json#/$defs/phone" },
    "contact_role": {
      "type": "string",
      "enum": ["billing", "operations", "facilities", "executive", "other"]
    },
    "is_primary": { "type": "boolean" },
    "status": { "type": "string", "enum": ["active", "inactive"] },
    "created_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" },
    "updated_at": { "$ref": "../common.schema.json#/$defs/iso_datetime" }
  }
}
