# Local development placeholders only.
# Copy to .env and replace values. Never commit .env or real credentials.

# Application
# local, development, or test. production and prod refuse to start:
# X-Laboratory-Actor is a development identity simulation, not authentication.
APP_ENV=local
APP_LOG_LEVEL=INFO
API_PORT=8000
CORS_ORIGINS=

# PostgreSQL — Docker Compose local defaults
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wasatch
POSTGRES_USER=wasatch
POSTGRES_PASSWORD=replace-me
WASATCH_DATABASE_URL=postgresql+psycopg://wasatch:replace-me@localhost:5432/wasatch
WASATCH_FIXTURES_DIR=

# Development activity log (development_ops schema on dedicated database)
DEVELOPMENT_OPS_DATABASE_URL=postgresql+psycopg://wasatch:replace-me@localhost:5432/wasatch_development_ops
DEVELOPMENT_OPS_GITHUB_REPOSITORY=anotherhale/ai-solutions-lab
DEVELOPMENT_OPS_MAX_CONCURRENT=3
DEVELOPMENT_OPS_ATTEMPT_AUTO_MERGE=1
DEVELOPMENT_OPS_SLACK_BOT_TOKEN=
DEVELOPMENT_OPS_SLACK_CHANNEL_ID=C0CFJDH7PTJ
DEVELOPMENT_OPS_REPORT_TZ=America/Denver

# Persistent coordinator runner (see docs/operations/COORDINATOR_RUNNER.md)
DEVELOPMENT_OPS_RUNNER_POLL_SECONDS=30
DEVELOPMENT_OPS_RUNNER_HEARTBEAT_SECONDS=300
DEVELOPMENT_OPS_LEASE_SECONDS=900
DEVELOPMENT_OPS_RUNNER_RECOVER=1
DEVELOPMENT_OPS_RUNNER_RECLAIM=1
DEVELOPMENT_OPS_RUNNER_STATE_DIR=
DEVELOPMENT_OPS_RUNNER_LOCK_PATH=
DEVELOPMENT_OPS_RUNNER_LOG_LEVEL=INFO
DEVELOPMENT_OPS_RUNNER_LOG_FORMAT=json

# Redis — not used in this slice
REDIS_HOST=localhost
REDIS_PORT=6379

# Model provider. fake does not call the network and does not need a key.
# openai is used only when AI_PROVIDER=openai and OPENAI_API_KEY is not a placeholder.
AI_PROVIDER=fake
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure — no cloud environment is deployed
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=

# Observability. Leave the endpoint blank. Spans export only when this
# value is a non-empty URL. A blank value does not open a socket and does
# not require a collector. Compose does not run a collector. Do not put
# credentials in this file.
OTEL_SERVICE_NAME=ai-solutions-lab
OTEL_EXPORTER_OTLP_ENDPOINT=
