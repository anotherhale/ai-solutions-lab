# Local development placeholders only.
# Copy to .env and replace values. Never commit .env or real credentials.

# Application
APP_ENV=local
APP_LOG_LEVEL=INFO

# PostgreSQL — no database is provisioned yet
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wasatch
POSTGRES_USER=wasatch
POSTGRES_PASSWORD=replace-me

# Redis — no cache is provisioned yet
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenAI — repository validation does not require a key
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini

# Azure — no cloud environment is deployed
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=

# Observability — no collector is required yet
OTEL_SERVICE_NAME=ai-solutions-lab
OTEL_EXPORTER_OTLP_ENDPOINT=
