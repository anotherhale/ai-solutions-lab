# Local development placeholders only.
# Copy to .env and replace values. Never commit .env or real credentials.

# Application
APP_ENV=local
APP_LOG_LEVEL=INFO
API_PORT=8000
CORS_ORIGINS=

# PostgreSQL — Docker Compose local defaults
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wasatch
POSTGRES_USER=wasatch
POSTGRES_PASSWORD=replace-me
WASATCH_DATABASE_URL=postgresql+psycopg://wasatch:replace-me@localhost:5432/wasatch
WASATCH_FIXTURES_DIR=

# Redis — not used in this slice
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenAI — not used in this slice
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini

# Azure — no cloud environment is deployed
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=

# Observability — no collector is required yet
OTEL_SERVICE_NAME=ai-solutions-lab
OTEL_EXPORTER_OTLP_ENDPOINT=
